#!/usr/bin/env node

/**
 * Module dependencies.
 */

var app = require('../app');
var debug = require('debug')('proyecto:server');
var http = require('http');

// Importa tu pool de conexiones a la base de datos aquí
const db = require('../conexion'); // Asegúrate que esta ruta sea correcta para tu 'conexion.js'


/**
 * Get port from environment and store in Express.
 */

var port = normalizePort(process.env.PORT || '3000');
app.set('port', port);

/**
 * Create HTTP server.
 */

var server = http.createServer(app);

/**
 * Listen on provided port, on all network interfaces.
 */

server.listen(port);
server.on('error', onError);
server.on('listening', onListening);

// --- ¡AÑADE ESTE BLOQUE DE CÓDIGO AQUÍ ABAJO! ---
console.log('Verificando conexión a la base de datos...');
db.getConnection(function(err, connection) { // Aquí usamos el callback que requiere el paquete 'mysql'
    if (err) {
        console.error('Error al conectar a la base de datos:', err.message);
        // Puedes considerar terminar la aplicación aquí si la conexión a la DB es crítica
        // process.exit(1);
        return; // Sal del callback si hay un error
    }
    console.log('Conexión a la base de datos MySQL exitosa!');
    connection.release(); // ¡Importante! Libera la conexión de vuelta al pool para que pueda ser usada por otras peticiones
});
// --- FIN DEL BLOQUE A AÑADIR ---

/**
 * Normalize a port into a number, string, or false.
 */

function normalizePort(val) {
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    // named pipe
    return val;
  }

  if (port >= 0) {
    // port number
    return port;
  }

  return false;
}

/**
 * Event listener for HTTP server "error" event.
 */

function onError(error) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  var bind = typeof port === 'string'
    ? 'Pipe ' + port
    : 'Port ' + port;

  // handle specific listen errors with friendly messages
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
      break;
    default:
      throw error;
  }
}

/**
 * Event listener for HTTP server "listening" event.
 */

function onListening() {
  var addr = server.address();
  var bind = typeof addr === 'string'
    ? 'pipe ' + addr
    : 'port ' + addr.port;
  debug('Listening on ' + bind);
   // --- ¡AÑADE O ASEGÚRATE DE QUE ESTA LÍNEA EXISTA AQUÍ! ---
  console.log('Servidor escuchando en http://localhost:' + addr.port); // <--- ¡Esta es la que queremos!
}
