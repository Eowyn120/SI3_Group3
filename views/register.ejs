      <!-- Javascript files-->
      <script src="js/jquery.min.js"></script>
      <script src="js/popper.min.js"></script>
      <script src="js/bootstrap.bundle.min.js"></script>
      <script src="js/jquery-3.0.0.min.js"></script>
    
      <!-- sidebar -->
      <script src="js/jquery.mCustomScrollbar.concat.min.js"></script>
      <script src="js/custom.js"></script>
      <script src="https:cdnjs.cloudflare.com/ajax/libs/fancybox/2.1.5/jquery.fancybox.min.js"></script>
      <script>
        document.addEventListener('DOMContentLoaded', function() {
            const addPatientBtn = document.getElementById('addPatientBtn');

            if (addPatientBtn) {
                // Añade un 'event listener' para el clic del botón
                addPatientBtn.addEventListener('click', function(event) {
                    // *** ¡ESTA ES LA LÍNEA CLAVE! ***
                    // Previene la acción por defecto del evento.
                    // Si el botón está dentro de un formulario y es de tipo "submit",
                    // esto evitará que el formulario se envíe y recargue/redireccione la página.
                    event.preventDefault(); 

                    // Ahora muestra el alert tradicional de JavaScript
                    window.alert('¡Te has registrado exitosamente!');

                    // IMPORTANTE: Si después de mostrar el alert SÍ quieres que haya una redirección,
                    // debes hacerla manualmente AQUÍ, después del alert.
                    // Por ejemplo:
                    window.location.href = '/users'; 
                    // o para simular un envío de formulario si es necesario:
                    // document.getElementById('tuFormularioID').submit(); 
                });
            } else {
                console.error("El botón con ID 'addPatientBtn' no fue encontrado.");
            }
        });
        
      </script>      
