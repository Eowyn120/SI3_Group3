      <!--  contact -->
      <div id="contact" class="contact">
         <div class="container">
            <div class="row">
               <div class="col-md-12 col-sm-12">
                  <div class="titlepage">
                     <h2>Registrate</h2>
                  </div>
               </div>
               <div class="col-md-8 offset-md-2">
                  <form id="request" class="main_form" method="post" action="/register">
                     <div class="row">
                        <div class="col-md-12 ">
                           <label class="input-label-simple">Nombres:</label>
                           <input class="contactus" placeholder="Nombres" type="text" name="nombre" required> 
                        </div>
                        <div class="col-md-12 ">
                           <label class="input-label-simple">Apellidos:</label>
                           <input class="contactus" placeholder="Apellidos" type="text" name="apellido" required> 
                        </div>
                        <div class="col-md-12">
                           <label class="input-label-simple">Correo Electronico:</label>
                           <input class="contactus" placeholder="Correo electronico" type="email" name="email" required> 
                        </div>
                        <div class="col-md-12">
                           <label class="input-label-simple">Contraseña:</label>
                           <input class="contactus" placeholder="Contraseña" type="password" name="password" required>                          
                        </div>
                        <div class="col-md-12 ">
                           <label class="input-label-simple">Pregunta secreta:</label>
                           <input class="contactus" placeholder="Pregunta secreta" type="text" name="preg" required> 
                        </div>
                        <div class="col-md-12 ">
                           <label class="input-label-simple">Respuesta secreta:</label>
                           <input class="contactus" placeholder="Respuesta secreta" type="text" name="resp" required> 
                        </div>
                        <div class="col-sm-12">
                           <button id="addPatientBtn" class="send_btn">Registrarse</button>
                        </div>
                     </div>
                  </form>
               </div>
            </div>
            </div>
         </div>
      </div>
