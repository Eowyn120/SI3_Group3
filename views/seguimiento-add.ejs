      <script src="https:cdnjs.cloudflare.com/ajax/libs/fancybox/2.1.5/jquery.fancybox.min.js"></script>
      <script>
    // --- Datos de la Base de Datos Pasados por EJS ---
    // Tus datos vendrán directamente como variables EJS:
    //EL ERROR EN LAS DECLARACIONES DE ESTAS DOS VARIABLES SON UN FALSO POSITIVO DEL AUTOCORRECTOR DE VSC
    const imcEstados = <%- JSON.stringify(imc) %>;
    const condicionesDB = <%- JSON.stringify(condicion) %>;



    // --- Referencias a los elementos del DOM ---
    const pesoSeguimientoInput = document.getElementById('pesoSeguimiento');
    const tallaSeguimientoInput = document.getElementById('tallaSeguimiento');
    const imcDisplay = document.getElementById('imcDisplay');
    const imcCalculadoInput = document.getElementById('imcCalculado');
    const imcIdInput = document.getElementById('imcId');
    const imcEstadoDisplay = document.getElementById('imcEstadoDisplay');
    const condicionSelect = document.getElementById('condicionSelect');
    const condicionMultiplicadorInput = document.getElementById('condicionMultiplicador');
    const requerimientoCaloricoDisplay = document.getElementById('requerimientoCaloricoDisplay');
    const requerimientoCaloricoInput = document.getElementById('requerimientoCalorico');

    const proteinasPorcentajeInput = document.getElementById('proteinasPorcentaje');
    const lipidosPorcentajeInput = document.getElementById('lipidosPorcentaje');
    const carbohidratosPorcentajeInput = document.getElementById('carbohidratosPorcentaje');
    const porcentajeTotalDisplay = document.getElementById('porcentajeTotalDisplay');

    const caloriasProteinasDisplay = document.getElementById('caloriasProteinasDisplay');
    const caloriasProteinasInput = document.getElementById('caloriasProteinas');
    const gramajeProteinasDisplay = document.getElementById('gramajeProteinasDisplay');
    const gramajeProteinasInput = document.getElementById('gramajeProteinas');
    const racionesProteinasDisplay = document.getElementById('racionesProteinasDisplay');
    const racionesProteinasInput = document.getElementById('racionesProteinas');

    const caloriasLipidosDisplay = document.getElementById('caloriasLipidosDisplay');
    const caloriasLipidosInput = document.getElementById('caloriasLipidos');
    const gramajeLipidosDisplay = document.getElementById('gramajeLipidosDisplay');
    const gramajeLipidosInput = document.getElementById('gramajeLipidos');
    const racionesLipidosDisplay = document.getElementById('racionesLipidosDisplay');
    const racionesLipidosInput = document.getElementById('racionesLipidos');

    const caloriasCarbohidratosDisplay = document.getElementById('caloriasCarbohidratosDisplay');
    const caloriasCarbohidratosInput = document.getElementById('caloriasCarbohidratos');
    const gramajeCarbohidratosDisplay = document.getElementById('gramajeCarbohidratosDisplay');
    const gramajeCarbohidratosInput = document.getElementById('gramajeCarbohidratos');
    const racionesCarbohidratosDisplay = document.getElementById('racionesCarbohidratosDisplay');
    const racionesCarbohidratosInput = document.getElementById('racionesCarbohidratos');
    const submitButton = document.querySelector('#request button[type="submit"]');

    // --- Funciones de Cálculo ---

    // --- Carga inicial de Opciones de Condición (modificado) ---
    function cargarCondiciones() {
        condicionSelect.innerHTML = '<option value="">Seleccione una condición</option>';
        if (Array.isArray(condicionesDB) && condicionesDB.length > 0) {
            condicionesDB.forEach(item => {
                // Asegúrate de que 'item' tenga las propiedades 'id', 'nombre', y 'multiplicador'
                const option = document.createElement('option');
                option.value = item.id_condicion;
                option.textContent = item.nombre_condicion; // Asegúrate de que esta propiedad exista en tus resultados de DB
                option.dataset.multiplicador = item.multiplicador; // Asegúrate de que esta propiedad exista
                condicionSelect.appendChild(option);
            });
        } else {
            console.warn("No se encontraron condiciones o condicionesDB no es un array en el frontend.");
        }
    }

    // --- Función para calcular IMC (sin cambios en la lógica, solo usa 'imcEstados') ---
    function calcularIMC() {
        const peso = parseFloat(pesoSeguimientoInput.value);
        const tallaCm = parseFloat(tallaSeguimientoInput.value);

        if (isNaN(peso) || isNaN(tallaCm) || peso <= 0 || tallaCm <= 0) {
            imcDisplay.textContent = '0.00';
            imcCalculadoInput.value = '';
            imcEstadoDisplay.textContent = '';
            imcIdInput.value = '';
            return 0;
        }

        const tallaM = tallaCm / 100;
        const imcVal = peso / (tallaM * tallaM); // Renombré a imcVal para evitar conflicto con la variable 'imcEstados'
        imcDisplay.textContent = imcVal.toFixed(2);
        imcCalculadoInput.value = imcVal.toFixed(2);

        if (Array.isArray(imcEstados) && imcEstados.length > 0) {
             const estadoImc = imcEstados.find(estado => imcVal >= estado.min && imcVal <= estado.max);
             if (estadoImc) {
                 imcEstadoDisplay.textContent = `(${estadoImc.status_imc})`; // Asegúrate de que 'status' exista
                 imcIdInput.value = estadoImc.id_imc;
             } else {
                 imcEstadoDisplay.textContent = '(Indefinido)';
                 imcIdInput.value = '';
             }
        } else {
            console.error("La variable imcEstados no es un array o está vacía en el frontend. Verifica la data.");
            imcEstadoDisplay.textContent = '(Error de datos)';
            imcIdInput.value = '';
        }
        return imcVal;
    }

    function calcularRequerimientoCalorico() {
        const peso = parseFloat(pesoSeguimientoInput.value);
        const multiplicadorCondicion = parseFloat(condicionMultiplicadorInput.value);

        if (isNaN(peso) || isNaN(multiplicadorCondicion) || peso <= 0 || multiplicadorCondicion <= 0) {
            requerimientoCaloricoDisplay.textContent = '0.00';
            requerimientoCaloricoInput.value = '';
            return 0;
        }

        const requerimiento = peso * multiplicadorCondicion;
        requerimientoCaloricoDisplay.textContent = requerimiento.toFixed(2);
        requerimientoCaloricoInput.value = requerimiento.toFixed(2);
        return requerimiento;
    }

    function calcularMacronutrientes() {
        const totalCalorias = parseFloat(requerimientoCaloricoInput.value);
        const percProteinas = parseFloat(proteinasPorcentajeInput.value);
        const percLipidos = parseFloat(lipidosPorcentajeInput.value);
        const percCarbohidratos = parseFloat(carbohidratosPorcentajeInput.value);

        // Suma de porcentajes y ajuste
        const sumaPorcentajes = percProteinas + percLipidos + percCarbohidratos;
        porcentajeTotalDisplay.textContent = `${sumaPorcentajes.toFixed(2)}%`;

        if (sumaPorcentajes.toFixed(2) !== '100.00') {
            porcentajeTotalDisplay.style.color = 'red';
            submitButton.disabled = true; // Deshabilita el botón si no suma 100
        } else {
            porcentajeTotalDisplay.style.color = 'green';
            submitButton.disabled = false; // Habilita el botón si suma 100
        }


        if (isNaN(totalCalorias) || totalCalorias <= 0) {
            // Resetear todos los displays si no hay calorias válidas
            const resetVal = '0.00';
            caloriasProteinasDisplay.textContent = caloriasProteinasInput.value = resetVal + ' Kcal';
            gramajeProteinasDisplay.textContent = gramajeProteinasInput.value = resetVal + ' g';
            racionesProteinasDisplay.textContent = racionesProteinasInput.value = resetVal;
            // ... y así para lípidos y carbohidratos
            caloriasLipidosDisplay.textContent = caloriasLipidosInput.value = resetVal + ' Kcal';
            gramajeLipidosDisplay.textContent = gramajeLipidosInput.value = resetVal + ' g';
            racionesLipidosDisplay.textContent = racionesLipidosInput.value = resetVal;
            caloriasCarbohidratosDisplay.textContent = caloriasCarbohidratosInput.value = resetVal + ' Kcal';
            gramajeCarbohidratosDisplay.textContent = gramajeCarbohidratosInput.value = resetVal + ' g';
            racionesCarbohidratosDisplay.textContent = racionesCarbohidratosInput.value = resetVal;
            return;
        }

        // --- Calorías por Macronutriente ---
        const calProteinas = (totalCalorias * percProteinas) / 100;
        const calLipidos = (totalCalorias * percLipidos) / 100;
        const calCarbohidratos = (totalCalorias * percCarbohidratos) / 100;

        caloriasProteinasDisplay.textContent = `${calProteinas.toFixed(2)} Kcal`;
        caloriasProteinasInput.value = calProteinas.toFixed(2);
        caloriasLipidosDisplay.textContent = `${calLipidos.toFixed(2)} Kcal`;
        caloriasLipidosInput.value = calLipidos.toFixed(2);
        caloriasCarbohidratosDisplay.textContent = `${calCarbohidratos.toFixed(2)} Kcal`;
        caloriasCarbohidratosInput.value = calCarbohidratos.toFixed(2);

        // --- Gramaje por Macronutriente ---
        // Proteínas: 4 Kcal/g | Lípidos: 9 Kcal/g | Carbohidratos: 4 Kcal/g
        const gramProteinas = calProteinas / 4;
        const gramLipidos = calLipidos / 9;
        const gramCarbohidratos = calCarbohidratos / 4;

        gramajeProteinasDisplay.textContent = `${gramProteinas.toFixed(2)} g`;
        gramajeProteinasInput.value = gramProteinas.toFixed(2);
        gramajeLipidosDisplay.textContent = `${gramLipidos.toFixed(2)} g`;
        gramajeLipidosInput.value = gramLipidos.toFixed(2);
        gramajeCarbohidratosDisplay.textContent = `${gramCarbohidratos.toFixed(2)} g`;
        gramajeCarbohidratosInput.value = gramCarbohidratos.toFixed(2);

        // --- Raciones por Macronutriente ---
        // Proteínas: 7g/ración | Lípidos: 9g/ración | Carbohidratos: 15g/ración
        const racionesProteinas = gramProteinas / 7;
        const racionesLipidos = gramLipidos / 9;
        const racionesCarbohidratos = gramCarbohidratos / 15;

        racionesProteinasDisplay.textContent = racionesProteinas.toFixed(2);
        racionesProteinasInput.value = racionesProteinas.toFixed(2);
        racionesLipidosDisplay.textContent = racionesLipidos.toFixed(2);
        racionesLipidosInput.value = racionesLipidos.toFixed(2);
        racionesCarbohidratosDisplay.textContent = racionesCarbohidratos.toFixed(2);
        racionesCarbohidratosInput.value = racionesCarbohidratos.toFixed(2);
    }

    // --- Función Principal para Actualizar Todos los Cálculos ---
    function actualizarTodosLosCalculos() {
        calcularIMC();
        calcularRequerimientoCalorico();
        calcularMacronutrientes();
    }

    // --- Event Listeners ---
    document.addEventListener('DOMContentLoaded', () => {
        cargarCondiciones();
        // Establece una fecha por defecto para el input de fecha (hoy)
        const today = new Date().toISOString().split('T')[0];
        document.getElementById('fechaSeguimiento').value = today;

        // Si ya tienes valores iniciales para peso/talla, IMC se calculará
        // O si ya tienes una condición seleccionada, el requerimiento se calculará
        actualizarTodosLosCalculos(); // Ejecutar al cargar para cálculos iniciales
    });

    // Eventos para actualizar cálculos en tiempo real
    pesoSeguimientoInput.addEventListener('input', actualizarTodosLosCalculos);
    tallaSeguimientoInput.addEventListener('input', actualizarTodosLosCalculos);

    condicionSelect.addEventListener('change', () => {
        const selectedOption = condicionSelect.options[condicionSelect.selectedIndex];
        condicionMultiplicadorInput.value = selectedOption.dataset.multiplicador || ''; // Guarda el multiplicador
        actualizarTodosLosCalculos();
    });

    proteinasPorcentajeInput.addEventListener('input', () => {
        const lipidos = parseFloat(lipidosPorcentajeInput.value) || 0;
        const carbohidratos = parseFloat(carbohidratosPorcentajeInput.value) || 0;
        let proteinas = parseFloat(proteinasPorcentajeInput.value) || 0;

        // Si el usuario excede el 15%, lo limitamos
        if (proteinas > 15) {
            proteinas = 15;
            proteinasPorcentajeInput.value = 15;
        }
        // Ajustamos los carbohidratos para que sumen 100% si es posible
        let remaining = 100 - proteinas - lipidos;
        if (remaining < 55) remaining = 55; // Mínimo para carbohidratos
        if (remaining > 60) remaining = 60; // Máximo para carbohidratos

        carbohidratosPorcentajeInput.value = remaining.toFixed(2);
        actualizarTodosLosCalculos();
    });

    lipidosPorcentajeInput.addEventListener('input', () => {
        const proteinas = parseFloat(proteinasPorcentajeInput.value) || 0;
        let lipidos = parseFloat(lipidosPorcentajeInput.value) || 0;
        const carbohidratos = parseFloat(carbohidratosPorcentajeInput.value) || 0;

        // Si el usuario excede el 35%, lo limitamos
        if (lipidos > 35) {
            lipidos = 35;
            lipidosPorcentajeInput.value = 35;
        }

        // Ajustamos los carbohidratos para que sumen 100% si es posible
        let remaining = 100 - proteinas - lipidos;
        if (remaining < 55) remaining = 55; // Mínimo para carbohidratos
        if (remaining > 60) remaining = 60; // Máximo para carbohidratos

        carbohidratosPorcentajeInput.value = remaining.toFixed(2);
        actualizarTodosLosCalculos();
    });

    carbohidratosPorcentajeInput.addEventListener('input', () => {
        const proteinas = parseFloat(proteinasPorcentajeInput.value) || 0;
        const lipidos = parseFloat(lipidosPorcentajeInput.value) || 0;
        let carbohidratos = parseFloat(carbohidratosPorcentajeInput.value) || 0;

        // Si el usuario excede el 60%, lo limitamos
        if (carbohidratos > 60) {
            carbohidratos = 60;
            carbohidratosPorcentajeInput.value = 60;
        }
        // Aseguramos que la suma sea 100% ajustando ligeramente proteínas o lípidos
        let currentTotal = proteinas + lipidos + carbohidratos;
        if (currentTotal !== 100) {
            let diff = 100 - currentTotal;
            // Intenta ajustar proteínas o lípidos si están dentro de su rango
            if (proteinas + diff >= 10 && proteinas + diff <= 15) {
                proteinasPorcentajeInput.value = (proteinas + diff).toFixed(2);
            } else if (lipidos + diff >= 25 && lipidos + diff <= 35) {
                lipidosPorcentajeInput.value = (lipidos + diff).toFixed(2);
            } else {
                 // Si no se puede ajustar en rangos, se distribuirá el resto en carbohidratos, aunque exceda el rango.
                 // Este es un caso límite para asegurar el 100% de suma si los rangos son muy restrictivos.
                 // Una mejor UX sería forzar al usuario a que la suma dé 100% dentro de los rangos.
                 carbohidratosPorcentajeInput.value = (carbohidratos + diff).toFixed(2);
            }
        }
        actualizarTodosLosCalculos();
    });


    // --- Envío del Formulario ---
    const seguimientoCalculosForm = document.getElementById('request');
    seguimientoCalculosForm.addEventListener('submit', function(event) {
        // Validación final de los porcentajes antes del envío
        const totalPorcentajes = parseFloat(proteinasPorcentajeInput.value) + parseFloat(lipidosPorcentajeInput.value) + parseFloat(carbohidratosPorcentajeInput.value);

        if (totalPorcentajes.toFixed(2) !== '100.00') {
            event.preventDefault(); // IMPORTANTE: Detiene el envío del formulario
            alert('¡Advertencia! Los porcentajes de macronutrientes deben sumar exactamente 100%. Por favor, ajústelos antes de enviar.');
            // Opcional: podrías enfocar el primer campo con error, etc.
            return; // Sale de la función y evita el envío
        }
        console.log("Formulario validado y se enviará a través del action.");
        alert("Formulario validado. Enviando..."); // Puedes poner un mensaje breve
    });

</script>
   </body>
</html>

