

<!DOCTYPE html>
<html lang="es">
   <head>
      <!-- basic -->
      <meta charset="utf-8">
      <meta http-equiv="X-UA-Compatible" content="IE=edge">
      <!-- mobile metas -->
      <meta name="viewport" content="width=device-width, initial-scale=1">
      <meta name="viewport" content="initial-scale=1, maximum-scale=1">
      <!-- site metas -->
      <title>NutriCode</title>
      <meta name="keywords" content="">
      <meta name="description" content="">
      <meta name="author" content="">
      <!-- bootstrap css -->
      <link rel="stylesheet" href="/css/bootstrap.min.css">
      <!-- style css -->
      <link rel="stylesheet" href="/css/style.css">
      <!-- Responsive-->
      <link rel="stylesheet" href="/css/responsive.css">
      <!-- fevicon -->
      <link rel="icon" href="/imagesn/fevicon.png" type="image/gif" />
      <!-- Scrollbar Custom CSS -->
      <link rel="stylesheet" href="/css/jquery.mCustomScrollbar.min.css">
      <!-- Tweaks for older IEs-->
      <link rel="stylesheet" href="https://netdna.bootstrapcdn.com/font-awesome/4.0.3/css/font-awesome.css">
      <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/fancybox/2.1.5/jquery.fancybox.min.css" media="screen">
      <!--[if lt IE 9]>
      <script src="https://oss.maxcdn.com/html5shiv/3.7.3/html5shiv.min.js"></script>
      <script src="https://oss.maxcdn.com/respond/1.4.2/respond.min.js"></script><![endif]-->
   </head>
   <!-- body -->
   <body class="main-layout">
      <!-- loader  -->
      <div class="loader_bg">
         <div class="loader"><img src="/images/loading.gif" alt="#" /></div>
      </div>
      <!-- end loader -->
      <!-- header -->
      <header>
         <!-- header inner -->
         <div class="header">
            <div class="container-fluid">
               <div class="row">
                  <div class="col-xl-3 col-lg-3 col-md-3 col-sm-3 col logo_section">
                     <div class="full">
                        <div class="center-desk">
                           <div class="logo">
                              <a href="/"><img src="/imagesn/logon.png" alt="#" /></a>
                           </div>
                        </div>
                     </div>
                  </div>
                  <div class="col-xl-9 col-lg-9 col-md-9 col-sm-9">
                     <div class="header_information">
                        <nav class="navigation navbar navbar-expand-md navbar-dark ">
                           <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarsExample04" aria-controls="navbarsExample04" aria-expanded="false" aria-label="Toggle navigation">
                           <span class="navbar-toggler-icon"></span>
                           </button>
                           <div class="collapse navbar-collapse" id="navbarsExample04">
                              <ul class="navbar-nav mr-auto">
                                 <li class="nav-item">
                                 <li class="nav-item">
                                    <a class="nav-link" href="/users">Inicio</a>
                                 </li> 
                                 <li class="nav-item">
                                    <a class="nav-link" href="/#">Perfil</a>
                                 </li>

                              </ul>
                              <div class="sign_btn"><a href="/users/logout">Salir</a></div>
                           </div>
                        </nav>
                     </div>
                  </div>
               </div>
            </div>
         </div>
      </header>
      <!-- end header inner -->
      <!-- end header -->

    <div id="mainContentSection" class="contact">
        <div class="container">
            <div class="button-controls">
                <button id="toggleContentButton">Mostrar Información de Pacientes</button>
                <button id="addQueryButton">Agregar Consulta</button>
                </div>

            <div id="patientInfoContainer" class="content-hidden">
                <div class="row">
                    <div class="col-md-12 col-sm-12">
                        <div class="titlepage">
                            <h2>Paciente Encontrado</h2>
                        </div>
                    </div>
                    <div class="col-md-10 offset-md-1">
                        <div class="main_form">
                            <% if (datos && datos.length > 0) { %>
                                <% for (let i = 0; i < datos.length; i++){ %>
                                    <div class="patient-card">
                                        <h3>Paciente <%= (i + 1) %>: <%= datos[i].nombres %> <%= datos[i].apellidos %></h3>
                                        
                                        <div class="patient-details-grid">
                                            <div class="detail-item">
                                                <span class="detail-label">Cédula:</span> 
                                                <span class="detail-value"><%= datos[i].cedula %></span>
                                            </div>
                                            <div class="detail-item">
                                                <span class="detail-label">Edad:</span> 
                                                <span class="detail-value"><%= datos[i].edad %></span>
                                            </div>
                                            <div class="detail-item">
                                                <span class="detail-label">Fecha de Nacimiento:</span> 
                                                <span class="detail-value"><%= datos[i].fecha_de_nacimiento %></span>
                                            </div>
                                            <div class="detail-item">
                                                <span class="detail-label">Teléfono:</span> 
                                                <span class="detail-value"><%= datos[i].telefono %></span>
                                            </div>
                                            <div class="detail-item">
                                                <span class="detail-label">Correo Electrónico:</span> 
                                                <span class="detail-value"><%= datos[i].correo %></span>
                                            </div>
                                            <div class="detail-item">
                                                <span class="detail-label">Dirección:</span> 
                                                <span class="detail-value"><%= datos[i].direccion %></span>
                                            </div>
                                            <div class="detail-item">
                                                <span class="detail-label">Sexo:</span> 
                                                <span class="detail-value"><%= datos[i].condicion %></span>
                                            </div>
                                            <div class="detail-item">
                                                <span class="detail-label">Ant. Familiares:</span> 
                                                <span class="detail-value"><%= datos[i].ant_familiares %></span>
                                            </div>
                                            <div class="detail-item">
                                                <span class="detail-label">Alergias:</span> 
                                                <span class="detail-value"><%= datos[i].alergias %></span>
                                            </div>
                                            <div class="detail-item">
                                                <span class="detail-label">Ant. Personales:</span> 
                                                <span class="detail-value"><%= datos[i].ant_personales %></span>
                                            </div>
                                            <div class="detail-item">
                                                <span class="detail-label">Ant. Psicológicos:</span> 
                                                <span class="detail-value"><%= datos[i].ant_psicologicos %></span>
                                            </div>
                                            <div class="detail-item">
                                                <span class="detail-label">Patología:</span> 
                                                <span class="detail-value"><%= datos[i].nombre_patologia %></span>
                                            </div>
                                        </div>
                                        
                                        <div class="d-grid gap-2 d-md-flex justify-content-md-end patient-actions">
                                            <a href="/users/paciente-edit/<%= datos[i].id%>" class="btn btn-warning btn-sm">Actualizar</a>
                                        </div>
                                    </div>
                                    <hr class="patient-separator"> <% } %>
                            <% } else { %>
                                <div class="text-center text-muted py-4">
                                    No hay pacientes registrados en el sistema.
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>

            <div id="consultasHistoryContainer" class="content-visible mt-4"> <div class="row">
                    <div class="col-md-12 col-sm-12">
                        <div class="titlepage">
                            <h2>Historial de Consultas</h2>
                        </div>
                    </div>
                    <div class="col-md-10 offset-md-1">
                        <div class="main_form">
                            <div class="consultation-card">
                                <h4>Consulta del 2025-05-30</h4>
                                <div class="consultation-details">
                                    <p><span class="detail-label">Motivo:</span> Revisión de progreso.</p>
                                    <p><span class="detail-label">Peso:</span> 75 kg</p>
                                    <p><span class="detail-label">Altura:</span> 1.75 m</p>
                                    <p><span class="detail-label">IMC:</span> 24.49 (Normal)</p>
                                    <p><span class="detail-label">Observaciones:</span> Paciente mostrando buena adherencia al plan. Se recomienda mantener el enfoque en la hidratación.</p>
                                </div>
                                <div class="d-grid gap-2 d-md-flex justify-content-md-end consultation-actions">
                                    <button class="btn btn-info btn-sm">Ver Detalle Completo</button>
                                </div>
                            </div>
                            <hr class="patient-separator">
                            
                            <div class="consultation-card">
                                <h4>Consulta del 2025-04-15</h4>
                                <div class="consultation-details">
                                    <p><span class="detail-label">Motivo:</span> Primera evaluación.</p>
                                    <p><span class="detail-label">Peso:</span> 78 kg</p>
                                    <p><span class="detail-label">Altura:</span> 1.75 m</p>
                                    <p><span class="detail-label">IMC:</span> 25.51 (Sobrepeso)</p>
                                    <p><span class="detail-label">Observaciones:</span> Inicio de plan nutricional para pérdida de peso. Énfasis en hábitos saludables.</p>
                                </div>
                                <div class="d-grid gap-2 d-md-flex justify-content-md-end consultation-actions">
                                    <button class="btn btn-info btn-sm">Ver Detalle Completo</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>    
      <!--  footer -->
      <footer>
         <div class="footer">
            <div class="copyright">
               <div class="container">
                  <div class="row">
                     <div class="col-md-12">
                        <p>© 2025 NutriCode. Todos los Derechos Reservados</p>
                     </div>
                  </div>
               </div>
            </div>
         </div>
      </footer>
      <!-- end footer -->
      <!-- Javascript files-->
      <script src="/js/jquery.min.js"></script>
      <script src="/js/popper.min.js"></script>
      <script src="/js/bootstrap.bundle.min.js"></script>
      <script src="/js/jquery-3.0.0.min.js"></script>
    
      <!-- sidebar -->
      <script src="/js/jquery.mCustomScrollbar.concat.min.js"></script>
      <script src="/js/custom.js"></script>
      <script src="https:cdnjs.cloudflare.com/ajax/libs/fancybox/2.1.5/jquery.fancybox.min.js"></script>
      <script src="/js/custom-script.js"></script>
   </body>
</html>

